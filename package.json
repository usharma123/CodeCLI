    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@opentui/core": "^0.1.65",
    "@opentui/solid": "^0.1.65",
    "dotenv": "^17.2.3",
    "ink": "^6.6.0",
    "openai": "6.15.0",
    "pdf-parse": "2.4.5",
    "react": "19.2.3",
    "solid-js": "^1.9.10",
    "tiktoken": "^1.0.22"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "19.2.7",
    "babel-preset-solid": "^1.9.10",
    "bun-types": "^1.3.5",
    "esbuild": "^0.27.2",
